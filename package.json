{
  "name": "readport",
  "version": "0.9.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "Self-hosted tandem reading: a non-destructive reader/player overlay for existing ebook and audiobook libraries.",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @readport/server",
    "dev:web": "npm run dev --workspace @readport/web",
    "build": "npm run build --workspace @readport/shared && npm run build --workspace @readport/server && npm run build --workspace @readport/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build --workspace @readport/shared && npm run test --workspaces --if-present",
    "fixtures": "node scripts/generate-fixtures.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "qa": "node scripts/qa-browser.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "fflate": "0.8.3",
    "text2wav": "0.0.14",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0"
  },
  "optionalDependencies": {
    "@esbuild/darwin-arm64": "0.28.2",
    "@esbuild/darwin-x64": "0.28.2",
    "@esbuild/linux-arm64": "0.28.2",
    "@esbuild/linux-x64": "0.28.2",
    "@esbuild/win32-x64": "0.28.2",
    "@napi-rs/lzma-darwin-arm64": "1.5.1",
    "@napi-rs/lzma-darwin-x64": "1.5.1",
    "@napi-rs/lzma-linux-arm64-gnu": "1.5.1",
    "@napi-rs/lzma-linux-x64-gnu": "1.5.1",
    "@napi-rs/lzma-win32-x64-msvc": "1.5.1",
    "@rollup/rollup-darwin-arm64": "4.63.1",
    "@rollup/rollup-darwin-x64": "4.63.1",
    "@rollup/rollup-linux-arm64-gnu": "4.63.1",
    "@rollup/rollup-linux-x64-gnu": "4.63.1",
    "@rollup/rollup-win32-x64-msvc": "4.63.1"
  }
}
