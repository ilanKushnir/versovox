# TandemLeaf configuration
# Precedence: environment variables > in-app admin settings (stored in the database) > defaults.
# Any TL_* variable also accepts a TL_*_FILE variant pointing at a file containing the value
# (recommended for secrets, e.g. Docker secrets).

# --- Core ---
# Port the web/API server listens on.
TL_PORT=8383
# Bind address inside the container/host.
TL_HOST=0.0.0.0
# Writable state directory (SQLite database, derived indexes, progress). Local disk only — never SMB/NFS.
TL_DATA_DIR=/data
# Writable cache directory (covers, transcripts, alignment work). Safe to delete; will be rebuilt.
TL_CACHE_DIR=/cache
# Optional speech model packs directory (experimental transcription).
TL_MODELS_DIR=/models

# --- Libraries (read-only mounts) ---
# Comma-separated list of ebook root directories.
TL_EBOOK_DIRS=/library/ebooks
# Comma-separated list of audiobook root directories.
TL_AUDIOBOOK_DIRS=/library/audiobooks

# --- Security ---
# Secret used to sign/derive session material. REQUIRED in production.
# Generate one: openssl rand -hex 32
# Prefer TL_SESSION_SECRET_FILE=/run/secrets/tl_session_secret with Docker secrets.
TL_SESSION_SECRET=
# One-time first-run bootstrap token. Creating the admin account requires it,
# so whoever merely reaches a fresh instance first cannot take it over.
# Generate one: openssl rand -hex 16   (TL_SETUP_TOKEN_FILE also works.)
# If left empty, the server generates a token on first start and prints it in
# its log (also stored at <data>/setup-token). Consumed on admin creation.
TL_SETUP_TOKEN=
# Reverse-proxy trust for client IPs (rate limiting). Default 0: forwarded
# headers are ignored. Set 1 to trust local/private-network proxies, or a
# comma-separated list of proxy IPs/CIDRs to trust exactly those.
TL_TRUST_PROXY=0
# Set to "1" only when TandemLeaf is served over HTTPS (enables the Secure cookie flag).
# PWA installation and service workers require HTTPS (or localhost).
TL_TRUST_HTTPS=0
# Session lifetime in days.
TL_SESSION_DAYS=30

# --- Worker / jobs ---
# Run background jobs inside the web process (1) or rely on a separate worker container (0).
TL_INLINE_WORKER=1
# Maximum concurrent background jobs.
TL_JOB_CONCURRENCY=2

# --- Transcription (experimental) ---
# Provider: "none" (default), "fixture" (bundled sample transcripts), or "whisper-cli".
TL_TRANSCRIBE_PROVIDER=fixture
# For whisper-cli: path to a faster-whisper/whisper.cpp compatible executable you installed.
# TandemLeaf does NOT bundle a speech model. See docs/alignment.md.
TL_WHISPER_BIN=
TL_WHISPER_MODEL=
# Default transcription/alignment language (BCP-47), e.g. en, he.
TL_DEFAULT_LANGUAGE=en

# --- Library refresh ---
# Minutes between automatic rescans (new titles in Calibre/Audiobookshelf
# folders appear without a manual click). 0 disables.
TL_SCAN_INTERVAL_MINUTES=60

# --- Container runtime (entrypoint) ---
PUID=1000
PGID=1000
TZ=Etc/UTC

# --- Misc ---
# Log level: fatal|error|warn|info|debug|trace
TL_LOG_LEVEL=info
