#!/bin/sh
# versovox-model — fetch a whisper.cpp ggml model into the models volume.
#
#   docker compose exec versovox versovox-model large-v3-turbo
#   docker compose exec versovox versovox-model list
#
# Models come from the whisper.cpp maintainers' Hugging Face repo. Pick by
# language/quality: `large-v3-turbo` is the sweet spot for Hebrew and other
# non-English narration on a CPU-only server; `base`/`small` are fast but
# rough; `large-v3` is the most accurate and several times slower.
set -eu
MODELS_DIR="${VX_MODELS_DIR:-/models}"
BASE_URL="https://huggingface.co/ggerganov/whisper.cpp/resolve/main"
KNOWN="tiny base small medium large-v3 large-v3-turbo tiny.en base.en small.en medium.en"

name="${1:-}"
case "$name" in
  ""|-h|--help)
    echo "usage: versovox-model <model> | list"; echo "models: $KNOWN"; exit 1 ;;
  list)
    echo "available: $KNOWN"; echo "installed in $MODELS_DIR:"; ls -1 "$MODELS_DIR"/ggml-*.bin 2>/dev/null || echo "  (none)"; exit 0 ;;
esac
case " $KNOWN " in *" $name "*) ;; *) echo "unknown model: $name (try: $KNOWN)"; exit 1 ;; esac

file="ggml-$name.bin"
dest="$MODELS_DIR/$file"
if [ -s "$dest" ]; then echo "already present: $dest"; exit 0; fi
mkdir -p "$MODELS_DIR"
echo "downloading $file → $dest"
wget -q --show-progress -O "$dest.part" "$BASE_URL/$file"
mv "$dest.part" "$dest"
echo "done. Set VX_WHISPER_MODEL=$dest (and VX_TRANSCRIBE_PROVIDER=whisper-cli)."
