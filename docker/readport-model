#!/bin/sh
# readport-model — fetch the alignment model into the models volume from the
# command line. The same download is available with a progress bar in
# Settings → Alignment; this exists for a server with no browser attached.
#
#   docker compose exec readport readport-model install
#   docker compose exec readport readport-model status
set -eu
MODELS_DIR="${RP_MODELS_DIR:-/models}"
BASE="https://huggingface.co/onnx-community/mms-300m-1130-forced-aligner-ONNX/resolve/main"

# path inside the models volume | url
FILES="mms-fa/model_int8.onnx|$BASE/onnx/model_int8.onnx
mms-fa/vocab.json|$BASE/vocab.json
mms-fa/config.json|$BASE/config.json"

case "${1:-install}" in
  status)
    missing=0
    echo "$FILES" | while IFS='|' read -r rel _url; do
      if [ -s "$MODELS_DIR/$rel" ]; then
        echo "present  $rel  ($(wc -c <"$MODELS_DIR/$rel") bytes)"
      else
        echo "MISSING  $rel"
        missing=1
      fi
    done
    exit $missing
    ;;
  install)
    echo "Alignment model → $MODELS_DIR"
    echo "Licence: CC-BY-NC-4.0 — free for your own library, not for a paid service."
    echo "$FILES" | while IFS='|' read -r rel url; do
      dest="$MODELS_DIR/$rel"
      if [ -s "$dest" ]; then
        echo "already here: $rel"
        continue
      fi
      mkdir -p "$(dirname "$dest")"
      echo "downloading:  $rel"
      # To a temporary name first, so an interrupted download is never mistaken
      # for a complete one by the server's size check.
      wget -q --show-progress -O "$dest.part" "$url"
      mv "$dest.part" "$dest"
    done
    echo "Done. Alignment jobs that were waiting for it start on their own."
    ;;
  *)
    echo "usage: readport-model [install|status]" >&2
    exit 2
    ;;
esac
